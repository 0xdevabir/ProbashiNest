# Copy to .env and fill in. Never commit .env.

# LLM (used through probashi/llm.py)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Voice (Agent 4) — details in probashi/voice/README.md
# Speech-to-text: elevenlabs (default) | azure
VOICE_STT_PROVIDER=elevenlabs
# Text-to-speech: azure (default) | elevenlabs
VOICE_TTS_PROVIDER=azure
# true = if the chosen provider fails, try the other one when its keys are set
VOICE_FALLBACK=true
ELEVENLABS_API_KEY=
# Needed only for ElevenLabs text-to-speech; pick a Bangla-capable voice
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
# Azure region of the Speech resource, e.g. southeastasia
AZURE_SPEECH_REGION=
# Optional voice tuning (defaults shown)
# AZURE_TTS_VOICE=bn-BD-NabanitaNeural
# AZURE_TTS_RATE=-15%
# AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# ELEVENLABS_TTS_SPEED=0.9
# VOICE_STT_TIMEOUT_SECONDS=30
# VOICE_TTS_TIMEOUT_SECONDS=20
# VOICE_TTS_MAX_CHARS=540
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Backend (Agent 1)
# true = stub all three modules (fake, always-amber answers; no API keys needed)
# false = real modules. Or a comma list to stub some: extract,knowledge,voice
# If unset, the backend uses the real modules.
USE_STUBS=true
# Comma-separated origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Frontend (Agent 5)
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
