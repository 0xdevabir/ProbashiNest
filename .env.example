# Copy to .env and fill in. Never commit .env.

# LLM (used through probashi/llm.py)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Voice providers (Agent 4 fills in the options)
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=

# Backend (Agent 1)
# true = stub all three modules (fake, always-amber answers; no API keys needed)
# false = real modules. Or a comma list to stub some: extract,knowledge,voice
# If unset, the backend uses the real modules.
USE_STUBS=true
# Comma-separated origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Frontend (Agent 5)
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
