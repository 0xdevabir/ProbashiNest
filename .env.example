# Copy to .env and fill in. Never commit .env.

# LLM (used through probashi/llm.py)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Voice providers (Agent 4 fills in the options)
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=

# Backend (Agent 1)
USE_STUBS=true

# Frontend (Agent 5)
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
